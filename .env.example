# Set these environment variables in PowerShell before running the app.
DB_URL=jdbc:mysql://localhost:3306/earthpulse_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=earthpulse_user
DB_PASSWORD=replace-with-your-mysql-password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Admin account 1 (required to create the first admin at startup)
APP_ADMIN_EMAIL=admin1@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional second admin account (same role and dashboard permissions)
APP_ADMIN2_EMAIL=admin2@example.com
APP_ADMIN2_PASSWORD=replace-with-another-strong-password

# Change the salted hash and salt before public deployment.

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_INSTANCE_ID=

ADMIN_PIN_SALT=replace-with-a-random-salt
ADMIN_PIN_HASH=replace-with-a-generated-pin-hash
